# full-body art (WebP), generated by `npm run download:art`; may live on external storage
public/art/

# design reference images (local only)
design-refs/

# raw game tables, re-downloaded when needed. character_table.json and item_table.json
# were committed before this rule and stay tracked until removed with `git rm --cached`.
src/data/raw/

# generated media: recreate with the npm scripts instead of committing
#   download:art -> public/art (above), download:icons -> items, skills, equip, building,
#   generate:music -> music-covers, render-operator-idle.mjs -> operators-idle(-webp),
#   download-operator-art.mjs -> operators (legacy PNG, replaced by public/art)
public/operators/
public/operators-idle/
public/operators-idle-webp/
public/items/
public/skills/
public/equip/
public/building/
public/music-covers/
